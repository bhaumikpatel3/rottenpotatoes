<% content_for :title, "Add a movie | RottenPotatoes" %>
<%= link_to "← Back to collection", movies_path, class: "back-link" %>
<section class="form-page">
  <header class="form-heading">
    <p class="eyebrow">Make room on the shelf</p>
    <h1>Add a movie.</h1>
    <p class="intro">Every collection starts with a story worth remembering.</p>
  </header>
  <div class="form-card"><%= render "form", movie: @movie %></div>
</section>
